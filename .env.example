# IMAP Email Configuration
# Copy this file to .env and fill in your actual credentials

# IMAP server hostname
MAIL_HOST=your.imap.server.com

# Your email address
MAIL_USER=your-email@example.com

# Your email password or app-specific password
MAIL_PASS=your-password-here

# Source mailbox (usually INBOX)
MAIL_SOURCE_BOX=INBOX

# Destination mailbox (or Trash)
MAIL_DESTINATION_BOX=Archive

# Date range for processing (optional - can be overridden in code)
START_DATE=2020-01-01
END_DATE=2025-01-01
